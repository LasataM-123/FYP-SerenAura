{
  "expo": {
    "name": "FrontendUI",
    "slug": "FrontendUI",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontendui",
    "owner": "lasatam",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.lasata.serenaura",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-web-browser",
      "expo-font",
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "API_URL": "http://192.168.1.3:5000/api",
      "SOCKET_URL": "http://192.168.1.3:5000",
      "GOOGLE_CLIENT_ID": "795417114491-nuqrncq7d1tjhnjldc0dua98685gbqea.apps.googleusercontent.com",
      "WEB_CLIENT_ID": "795417114491-ktvjjmgq6q3tcnh58lca64577hohhqk3.apps.googleusercontent.com",
      "router": {},
      "eas": {
        "projectId": "acf35f13-3425-45a6-8693-c5cb1b13c627"
      }
    }
  }
}
